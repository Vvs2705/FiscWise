# FiscWise Backend Environment Variables
# Copy this file to .env and fill in the values

# Application
APP_NAME=FiscWise
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://fiscwise:fiscwise_dev_2026@localhost:5432/fiscwise_db
POSTGRES_USER=fiscwise
POSTGRES_PASSWORD=fiscwise_dev_2026
POSTGRES_DB=fiscwise_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://:fiscwise_redis_2026@localhost:6379/0
REDIS_PASSWORD=fiscwise_redis_2026
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Rotinas agendadas
# internal = APScheduler no processo (dev / servidor sempre ligado)
# external = Cloud Scheduler chama POST /api/v1/internal/tick de hora em hora
SCHEDULER_MODE=internal
# Header X-Cron-Secret do tick. Gere com: openssl rand -hex 32. Vazio = tick desligado.
CRON_SECRET=

# Supabase (Postgres + Storage)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# E-mail transacional (Resend)
RESEND_API_KEY=
RESEND_ENABLED=false

# Observabilidade
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO

# Pagamentos — Mercado Pago (assinatura mensal via preapproval)
# Cobrança fica DESLIGADA até PAGAMENTOS_GO_LIVE=true (o /billing/checkout responde 503).
# Em produção, defina no Google Secret Manager (nunca commitar valores reais).
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
PAGAMENTOS_GO_LIVE=false
APP_URL=https://www.fiscwise.com.br
