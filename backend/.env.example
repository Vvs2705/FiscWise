# FiscWise Backend Environment Variables
# Copy this file to .env and fill in the values

# Application
APP_NAME=FiscWise
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://fiscwise:fiscwise_dev_2026@localhost:5432/fiscwise_db
POSTGRES_USER=fiscwise
POSTGRES_PASSWORD=fiscwise_dev_2026
POSTGRES_DB=fiscwise_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://:fiscwise_redis_2026@localhost:6379/0
REDIS_PASSWORD=fiscwise_redis_2026
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
